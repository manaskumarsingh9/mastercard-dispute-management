modules = ["java-graalvm22.3", "nodejs-20", "postgresql-16"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["psmisc"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace && fuser -k 5000/tcp 2>/dev/null; sleep 1; ./mvnw spring-boot:run"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "java -jar target/mastercard-dispute-management-0.0.1-SNAPSHOT.jar"]
build = ["bash", "-c", "chmod +x mvnw && ./mvnw package -DskipTests -q"]
